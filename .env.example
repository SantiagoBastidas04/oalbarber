# =============================================================================
# OalBarber - variables de entorno de ejemplo
#
# Copia este archivo a .env y ajusta los valores:
#   cp .env.example .env        (Linux/macOS)
#   Copy-Item .env.example .env (PowerShell)
#
# .env NO se sube al repositorio (está en .gitignore). No pongas credenciales
# reales en este archivo de ejemplo.
# =============================================================================

# -----------------------------------------------------------------------------
# PostgreSQL
# POSTGRES_DB es el nombre de la base; la API lo recibe como DB_NAME.
# -----------------------------------------------------------------------------
POSTGRES_DB=oalbarber
POSTGRES_USER=oalbarber
POSTGRES_PASSWORD=cambia_esta_clave_en_local

# Puerto interno de PostgreSQL. Solo se publica al host si descomentas el
# mapeo de puertos del servicio postgres en docker-compose.yml.
DB_PORT=5432

# -----------------------------------------------------------------------------
# API Spring Boot
# Opciones de JVM. Se recomienda dejar MaxRAMPercentage y ajustar solo si hace
# falta (por ejemplo, agregar -Xmx512m o -Duser.timezone=America/Bogota).
# -----------------------------------------------------------------------------
JAVA_OPTS=-XX:MaxRAMPercentage=75

# -----------------------------------------------------------------------------
# pgAdmin (http://localhost:5050)
# El correo debe tener formato válido; la contraseña es solo para entrar a
# pgAdmin, no es la de PostgreSQL.
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@oalbarber.com
PGADMIN_DEFAULT_PASSWORD=cambia_esta_clave_de_pgadmin

# -----------------------------------------------------------------------------
# Frontend (nginx, http://localhost:3000)
# Puerto del host que publica la SPA. El contenedor escucha siempre en 8080.
# -----------------------------------------------------------------------------
FRONTEND_PORT=3000

# -----------------------------------------------------------------------------
# Autenticación (JWT)
# JWT_SECRETO firma el pase corto de sesión. Debe tener al menos 32 caracteres
# y NUNCA debe ser la misma que la de este archivo de ejemplo. Genera la tuya,
# por ejemplo con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# -----------------------------------------------------------------------------
JWT_SECRETO=cambia_esta_clave_de_al_menos_32_caracteres
JWT_MINUTOS_ACCESO=15
REFRESH_DIAS=7

# -----------------------------------------------------------------------------
# Administrador inicial: se crea una sola vez al arrancar la API si no existe.
# Si ya existe un usuario con ese celular, NO se toca su contraseña ni su rol.
# -----------------------------------------------------------------------------
ADMIN_CELULAR=+573001112233
ADMIN_NOMBRE=OAlBarber Admin
ADMIN_CONTRASENA=cambia_esta_clave_de_admin
